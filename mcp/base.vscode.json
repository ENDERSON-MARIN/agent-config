{
  // Preset MCP para VSCode/Copilot. Auth sempre via env vars — nunca secret aqui.
  // Servidores pos-MVP ficam de fora de proposito: adicione somente quando
  // habilitados no opencode.json do projeto (fonte canonica de MCPs).
  "servers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
