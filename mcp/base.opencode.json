{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "timeout": 10000
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "mercadopago": {
      "type": "remote",
      "url": "https://mcp.mercadopago.com/mcp",
      "enabled": false
    },
    "resend": {
      "type": "remote",
      "url": "https://mcp.resend.com/mcp",
      "enabled": false
    },
    "brevo": {
      "type": "remote",
      "url": "https://mcp.brevo.com/v1/brevo/mcp",
      "headers": {
        "Authorization": "Bearer {env:BREVO_MCP_TOKEN}"
      }
    }
  },
  "permission": {
    "context7_*": "deny",
    "playwright_*": "deny",
    "cloudflare_*": "deny",
    "mercadopago_*": "deny",
    "resend_*": "deny",
    "brevo_*": "deny",
    "brevo_transac_templates_send_transac_email": "ask",
    "brevo_email_campaign_management_send_test_email": "ask",
    "brevo_templates_send_test_template": "ask",
    "brevo_contacts_get_contacts": "allow",
    "brevo_contacts_get_contact_info": "allow",
    "brevo_templates_get_smtp_templates": "allow",
    "brevo_senders_get_senders": "allow"
  }
}
